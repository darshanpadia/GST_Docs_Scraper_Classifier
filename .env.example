# Copy this file to .env and adjust as needed. All values are optional --
# sensible defaults are baked into gst_agent/config.py.

# Maximum number of NEW documents to download in a single run.
MAX_NEW_DOCS_PER_RUN=100

# Politeness settings for scraping.
REQUEST_DELAY_SECONDS=1.5
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=3

# Included in the User-Agent header sent to government servers, so a human
# can identify/contact us if our crawling causes any issue.
USER_AGENT_CONTACT=your-email@example.com

# OCR fallback threshold: pages with fewer than this many extracted
# characters (on average) are treated as scanned/image-based.
OCR_MIN_CHARS_PER_PAGE=20

# Only needed on Windows if Tesseract isn't on PATH, e.g.:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Web UI (gst-agent-ui / python -m gst_agent.web) bind address and port.
# Defaults are safe for local use (loopback-only). The Docker image
# overrides WEB_UI_HOST to 0.0.0.0 itself -- do not set that natively
# unless you specifically want the dashboard reachable from your network
# (it has no authentication).
WEB_UI_HOST=127.0.0.1
WEB_UI_PORT=5000

# Comma-separated list of source modules to run. "indiacode" is implemented
# and tested but disabled by default: indiacode.nic.in's robots.txt permits
# crawling, but its server 403s our honestly-identifying User-Agent (a
# WAF-level check, not a robots.txt rule). We do not spoof a browser UA to
# get past that -- see gst_agent/sources/indiacode.py for details. Add it
# back here only if you have your own way to satisfy that server's policy.
ENABLED_SOURCES=cbic,gstcouncil

# Whether to use an LLM as a fallback classifier for documents the fast,
# free, rule-based classifier can't confidently categorize. Off by default --
# the rule-based pass handles the common cases and needs no API key. When on,
# it's used only as a fallback (never the primary classifier), and any
# failure (missing key, network error, refusal) is caught and simply leaves
# the document as "Other" rather than failing the run.
ENABLE_LLM_FALLBACK=false

# Providers tried in this order (see gst_agent/llm_providers/) -- a provider
# with no API key set below is skipped, not an error, so it's fine to leave
# a provider listed here that you haven't configured. Both defaults are
# genuinely free, no credit card required:
#   Gemini: aistudio.google.com/apikey  (1,500 requests/day free)
#   Groq:   console.groq.com/keys       (14,400 requests/day free)
LLM_PROVIDER_ORDER=gemini,groq

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Anthropic isn't in LLM_PROVIDER_ORDER by default (it isn't free), but is
# implemented -- add "anthropic" to the order above if you have a key.
# Only read (by the `anthropic` SDK itself) when actually used.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5

# How many times a *new* category must be independently proposed by the LLM
# fallback -- across different documents, cumulative across runs -- before
# the agent creates a real folder for it and starts filing matching
# documents there. Keeps one LLM guess from creating folder sprawl while
# still letting a genuinely recurring, previously-unanticipated document type
# earn its own category.
CATEGORY_PROMOTION_THRESHOLD=3
